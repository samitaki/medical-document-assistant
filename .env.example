# the only api key in this project, used for answer generation
ANTHROPIC_API_KEY=sk-ant-replace-me

# qdrant from docker-compose
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_docs

# embeddings run locally through fastembed, no api key needed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# cross-encoder reranking. off because it measured worse, see the readme.
# turning it on needs the extra install at the bottom of requirements.txt
RERANK_ENABLED=false

# where uploaded pdfs are kept
UPLOAD_DIR=./uploads

# frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:8000
